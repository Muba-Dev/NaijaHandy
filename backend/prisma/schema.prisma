// Prisma schema — ArtisanNG
// Database: Neon PostgreSQL
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

// Seed
// npx prisma db seed

datasource db {
  // Switch to "postgresql" for Neon Postgres in production
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

// SQLite-compatible — enums stored as String; for Postgres, restore `enum Role { ... }` / `enum BookingStatus { ... }`

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  city      String?
  address   String?
  latitude  Float?
  longitude Float?
  password  String?
  googleId  String?  @unique
  role      String   @default("CUSTOMER")
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  avatar    String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  artisanProfile     ArtisanProfile?
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  reviews            Review[]
  savedArtisans      SavedArtisan[]
  refreshTokens      RefreshToken[]
  disputesRaised     Dispute[] @relation("RaisedDisputes")
  passwordResetTokens PasswordResetToken[]
  notifications      Notification[]
  supportMessages    SupportMessage[]
  supportChatLogs    SupportChatLog[]

  @@map("users")
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | REPLIED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("support_messages")
}

// Help Centre articles — the single source of truth for the /help page and the
// RAG corpus backing the AI support assistant. `embedding` is a pgvector
// column (text-embedding-3-small, 1536 dims) managed via raw SQL — Prisma
// only knows it exists (Unsupported), never reads/writes it directly.
model HelpArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  category  String   // Getting started | Booking & payments | Trust & safety | Disputes & guarantee | For artisans
  title     String
  content   String
  order     Int      @default(0)
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([category])
  @@map("help_articles")
}

// Quality + rate-limit log for the AI assistant. Stores only the sanitized
// question, matched article IDs, and confidence — never booking payloads.
model SupportChatLog {
  id         String    @id @default(cuid())
  userId     String?
  ipHash     String? // sha256 of the request IP (guest rate limiting; never raw IPs)
  question   String
  answer     String?
  articleIds String? // JSON array of matched HelpArticle ids
  confidence Float?
  model      String?
  escalated  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("support_chat_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // BOOKING_REQUEST | BOOKING_ACCEPTED | BOOKING_DECLINED | BOOKING_CANCELLED | BOOKING_COMPLETED | REVIEW_RECEIVED | PROFILE_APPROVED | PROFILE_REJECTED | PAYMENT_RECEIVED
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model ArtisanProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  profession  String
  category    String
  bio         String
  hourlyRate  Int      // in kobo (smallest NGN unit) or plain NGN
  coverImage  String?
  verified    Boolean  @default(false)
  available   Boolean  @default(true)
  approvalStatus    String @default("PENDING")   // PENDING | APPROVED | REJECTED
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationDocUrl String?
  isDemo   Boolean  @default(false)
  avgRating   Float    @default(0)
  totalReviews Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  Service[]
  portfolio PortfolioItem[]
  bookings  Booking[] @relation("ArtisanBookings")
  reviews   Review[]
  savedBy   SavedArtisan[]

  @@map("artisan_profiles")
}

model Service {
  id        String   @id @default(cuid())
  artisanId String
  name      String
  rate      Int      // NGN
  createdAt DateTime @default(now())

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("services")
}

model PortfolioItem {
  id        String   @id @default(cuid())
  artisanId String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  artisanId   String
  date        DateTime
  time        String
  description String
  amount      Int           // NGN
  address     String?
  customerPhone String?
  isUrgent    Boolean       @default(false)
  status      String   @default("PENDING")
  paymentStatus String      @default("UNPAID")
  paymentReference String?  @unique
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User           @relation("CustomerBookings", fields: [customerId], references: [id])
  artisan  ArtisanProfile @relation("ArtisanBookings", fields: [artisanId], references: [id])
  review   Review?
  payment  Payment?
  disputes Dispute[]

  @@map("bookings")
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  reference   String   @unique
  amount      Int
  status      String   @default("PENDING")
  provider    String   @default("PAYSTACK")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  customerId String
  artisanId  String
  rating    Int      // 1–5
  comment   String
  photoUrl  String?
  status    String   @default("APPROVED") // APPROVED | HIDDEN
  createdAt DateTime @default(now())

  booking  Booking        @relation(fields: [bookingId], references: [id])
  customer User           @relation(fields: [customerId], references: [id])
  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id])

  @@map("reviews")
}

model Dispute {
  id         String   @id @default(cuid())
  bookingId  String
  raisedBy   String
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation("RaisedDisputes", fields: [raisedBy], references: [id])

  @@map("disputes")
}

model SavedArtisan {
  id        String   @id @default(cuid())
  userId    String
  artisanId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([userId, artisanId])
  @@map("saved_artisans")
}
