# NaijaHandy backend environment variables
# Copy to .env and fill in real values:  cp .env.example .env

# Supabase PostgreSQL connection string.
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Use the SESSION connection pooler (port 5432, IPv4) for the backend / Prisma / migrations:
#   postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# NOTE: the direct host db.PROJECT_REF.supabase.co is IPv6-only and will fail (P1001)
# on networks without IPv6. If the pooler also fails, keep a ?sslmode=require suffix.
# URL-encode special chars in the password (e.g. '@' -> %40).
# NOTE: this project uses a PostgreSQL/Supabase schema — the old SQLite dev.db setup
# (Prisma schema is provider = "postgresql") no longer applies.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign JWT access + refresh tokens. Use a long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-key"

# Frontend origin allowed by CORS.
FRONTEND_URL="http://localhost:3000"

# API port.
PORT=4000

# ─── Email (for password reset) ───────────────────────────────────────────────
# Free option: use your Gmail account + a Gmail "App Password".
# 1. Enable 2-Step Verification on your Google account.
# 2. Google Account -> Security -> App passwords -> create one for "Mail".
# 3. Put your Gmail address in SMTP_USER and the 16-char app password in SMTP_PASS.
# EMAIL_ENABLED=true additionally sends booking/approval notification emails
# (confirmed/completed/cancelled bookings, artisan approval/verification, and
# new-artisan-PENDING alerts to admins). Those notifications are error-swallowed
# and skipped unless EMAIL_ENABLED is exactly "true". The password-reset email is
# not gated by this flag.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="NaijaHandy <youraddress@gmail.com>"
EMAIL_ENABLED="false"

# ─── Google OAuth (Continue with Google) ──────────────────────────────────────
# FREE. Get credentials: https://console.cloud.google.com -> create a project ->
# "OAuth consent screen" (External, add your Google account as a test user) ->
# "Credentials" -> "Create credentials" -> "OAuth client ID" (Web application).
# Add http://localhost:4000/api/auth/google/callback to Authorized redirect URIs.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Paystack (https://paystack.com). Set PAYSTACK_MOCK=true to run the payment
# flow offline without real API keys.
PAYSTACK_SECRET_KEY="sk_test_your_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_key"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="http://localhost:3000/bookings"
PAYSTACK_MOCK="true"

# Demo-data labeling. The seed marks the 10 demo artisans + demo customers
# with isDemo=true by default. Set SEED_DEMO=0 in production to seed them as
# real (non-demo) accounts instead.
SEED_DEMO="true"

# ─── AI support assistant (Help chat) ─────────────────────────────────────────
# The RAG assistant answers from the Help Centre articles (pgvector embeddings
# + an LLM). SUPPORT_CHAT_ENABLED=true turns on the chat endpoint + widget.
# SUPPORT_CHAT_MOCK=true runs it fully offline with deterministic keyword-match
# answers (used by e2e/dev; implies enabled — no key needed).
SUPPORT_CHAT_ENABLED="false"
SUPPORT_CHAT_MOCK="false"
# OpenAI API key (https://platform.openai.com/api-keys). Required for real
# embeddings + answers; without it the chat falls back to keyword retrieval.
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
# Optional: OpenAI-compatible base URL to point at a proxy / other provider.
LLM_BASE_URL=""
# Min cosine similarity before the assistant admits it doesn't know (0.0-1.0).
SUPPORT_CHAT_CONFIDENCE_THRESHOLD="0.25"
# Max chat requests per user/IP per hour (cost + abuse guard).
SUPPORT_CHAT_RATE_LIMIT="20"
# Generate embeddings for the help corpus:  npm run db:embed-help
# (or POST /api/help/articles/embed as an admin).
